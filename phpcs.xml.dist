<?xml version="1.0"?>
<ruleset name="cf7-to-api">
	<description>WordPress coding standards for Contact Form 7 to API.</description>
	<file>.</file>
	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<config name="minimum_supported_wp_version" value="6.7"/>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/.grok/*</exclude-pattern>

	<rule ref="WordPress-Core">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="PEAR.NamingConventions.ValidClassName"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="qs_cf7_api"/>
				<element value="QS_CF7"/>
				<element value="QS_Admin"/>
				<element value="qsCf7"/>
			</property>
		</properties>
	</rule>
</ruleset>
